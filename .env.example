# Copy to `.env` (project root or backend/) and fill in what you need.
# Never commit real keys.

# --- Required for speech-to-text ---
DEEPGRAM_API_KEY=

# --- Optional language models (without them the agent answers from the knowledge base) ---
# Used by the "Streaming LLM" mode.
OPENAI_API_KEY=
# Used by the "Batch" and "Streaming" modes.
GEMINI_API_KEY=

# --- Optional model overrides ---
# DEEPGRAM_MODEL=nova-2
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Server ---
# Comma-separated origins allowed to call the API cross-origin (empty = same-origin only).
# CORS_ORIGINS=http://localhost:5173
# MAX_UPLOAD_BYTES=10485760
# HTTP_TIMEOUT_SECONDS=30

# --- Benchmark page ---
# ENABLE_BENCHMARK=true
# Let the benchmark fall back to OPENAI_API_KEY when the visitor supplies no key.
# Leave false on public deployments so strangers cannot spend your quota.
# BENCHMARK_ALLOW_SERVER_KEY=false
